{
  "manifest_version": 3,
  "name": "BOSS 岗位助手（只读）",
  "version": "0.1.0",
  "description": "在你已打开的 BOSS 直聘岗位列表页上，只读抓取岗位卡片并导出 CSV/JSON。不登录、不点击、不发消息。",
  "permissions": ["downloads"],
  "host_permissions": ["https://*.zhipin.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "抓取当前页岗位"
  },
  "content_scripts": [
    {
      "matches": ["https://*.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
