{
  "manifest_version": 3,
  "name": "BOSS 自动投递助手",
  "version": "0.4.0",
  "description": "在你已登录的 BOSS 网页里自动搜索/筛选/打招呼（低限额、可暂停）。个人求职助手，风险自担。",
  "permissions": [
    "downloads",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.zhipin.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BOSS 自动投递助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
